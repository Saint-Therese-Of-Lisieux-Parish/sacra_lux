{
  "name": "sacra-lux",
  "version": "0.0.93-alpha",
  "description": "Catholic Mass presentation app with phone remote control",
  "main": "src/main.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "electron ./src/main.js",
    "web": "node ./src/web.js",
    "build": "electron-builder --mac --win",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "lint": "npm run lint:js && npm run lint:html && npm run lint:css",
    "lint:js": "eslint src tests scripts public eslint.config.js",
    "lint:html": "htmlhint \"public/*.html\"",
    "lint:css": "stylelint \"public/*.css\" \"public/*.html\"",
    "check:version-sync": "node ./scripts/check-version-sync.js",
    "precommit": "node ./scripts/precommit.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config ./jest.config.cjs tests/unit --runInBand",
    "test:integration": "jest --config ./jest.config.cjs tests/integration --runInBand",
    "test:coverage": "jest --config ./jest.config.cjs tests/unit tests/integration --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "keywords": [
    "catholic",
    "liturgy",
    "mass",
    "presentation",
    "electron",
    "projection"
  ],
  "author": "Robert Toups",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Saint-Therese-Of-Lisieux-Parish/sacra_lux.git"
  },
  "bugs": {
    "url": "https://github.com/Saint-Therese-Of-Lisieux-Parish/sacra_lux/issues"
  },
  "homepage": "https://github.com/Saint-Therese-Of-Lisieux-Parish/sacra_lux",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.13.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.13.0",
    "htmlhint": "^1.9.2",
    "jest": "^30.5.2",
    "postcss-html": "^2.0.0",
    "socket.io-client": "^4.8.4",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "supertest": "^7.3.1"
  },
  "build": {
    "appId": "com.toups.sacra-lux",
    "productName": "Sacra Lux",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "build/icon.png",
      "build/icon-splash.png",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "prayers",
        "to": "prayers"
      },
      {
        "from": "backgrounds",
        "to": "backgrounds"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "public/**/*"
    ],
    "directories": {
      "output": "${env.HOME}/Documents/sacra-lux-dist"
    }
  }
}
