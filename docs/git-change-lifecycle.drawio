        <mxCell id="N1" value="Change request &#8212; GitHub Issue with EARS requirements and acceptance criteria" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F6FEB;gradientColor=#7C3AED;gradientDirection=east;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
