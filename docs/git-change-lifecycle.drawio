        <mxCell id="N1" value="Change request &#8212; GitHub Issue with EARS requirements and acceptance criteria" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1F3B73;strokeColor=none;fontColor=#F5EFE2;fontSize=14;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1">
