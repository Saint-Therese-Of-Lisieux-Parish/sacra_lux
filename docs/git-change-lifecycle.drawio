        </mxCell>
        <mxCell id="D1" value="Are the acceptance criteria confirmed by a human (or an owner-requested EARS rewrite)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBF6EA;strokeColor=#7A2230;strokeWidth=1.5;fontColor=#2A2823;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="480" y="376" width="520" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="N1b" value="Comment with proposed criteria; ask the author to confirm. Do not start work." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FBF6EA;strokeColor=#A8862B;strokeWidth=1.5;fontColor=#2A2823;fontSize=12.5;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="1120" y="376" width="440" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="N2" value="git fetch origin &#8212; sync refs before you branch" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="596" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="N3" value="Move the conversation into a new worktree; confirm the base is current origin/master" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="688" width="560" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="N4" value="Work only inside the worktree. Verify the path and branch before each change." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="800" width="560" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="B1" value="Commit each logical change as you go" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="916" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="B2" value="Reference the issue in every commit (Refs #n)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="1012" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="B3" value="Stage files deliberately by name &#8212; no git add ." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="1108" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="C1" value="Run tests, linters, and formatters from inside the worktree" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="1208" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="C2" value="Verify the change against every acceptance criterion" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="1304" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="C3" value="Never skip, disable, or weaken a check" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="1400" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="D2" value="Do all tests, linters, and acceptance criteria pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBF6EA;strokeColor=#7A2230;strokeWidth=1.5;fontColor=#2A2823;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="480" y="1526" width="520" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="N7" value="git push -u origin &amp;lt;branch&amp;gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="1756" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="N8" value="Open a small, focused PR into master with gh" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="1848" width="560" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="N9" value="CI runs &#8212; wait with gh pr checks --watch" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="1964" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="D3" value="Do all required status checks pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBF6EA;strokeColor=#7A2230;strokeWidth=1.5;fontColor=#2A2823;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="480" y="2086" width="520" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="D4" value="Did a human initiate the request?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBF6EA;strokeColor=#7A2230;strokeWidth=1.5;fontColor=#2A2823;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="480" y="2326" width="520" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="N10" value="Stop at the open PR; wait for a human to approve" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FBF6EA;strokeColor=#A8862B;strokeWidth=1.5;fontColor=#2A2823;fontSize=12.5;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="1120" y="2326" width="440" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="D5" value="Does the change touch migrations, IaC, auth/billing, or production config?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBF6EA;strokeColor=#7A2230;strokeWidth=1.5;fontColor=#2A2823;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="480" y="2566" width="520" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="N11" value="Open the PR, add needs-human-approval, and stop" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7E9EA;strokeColor=#7A2230;strokeWidth=1.5;fontColor=#5E1A26;fontSize=12.5;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="1120" y="2566" width="440" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="N12" value="Re-sync with master; renumber the version if master moved; re-run checks" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="2796" width="560" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="N13" value="Merge with a merge commit &#8212; gh pr merge &amp;lt;pr&amp;gt; --merge" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="2912" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="N14" value="Confirm the PR state is MERGED" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="3008" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="D6" value="Is the worktree clean with nothing unpushed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBF6EA;strokeColor=#7A2230;strokeWidth=1.5;fontColor=#2A2823;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="480" y="3136" width="520" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="N15" value="Stop and ask a human" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7E9EA;strokeColor=#7A2230;strokeWidth=1.5;fontColor=#5E1A26;fontSize=12.5;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="1120" y="3136" width="440" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="N16" value="Move back to the main folder; git worktree remove; git branch -d; delete the remote branch" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="3366" width="560" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="N17" value="git worktree prune; git fetch --prune; git pull --ff-only" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFDF8;strokeColor=#D9C48A;strokeWidth=1.5;fontColor=#2A2823;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="3482" width="560" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="N18" value="Done &#8212; master updated, issue closed, no leftover worktree or branch" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2E6B4F;strokeColor=none;fontColor=#F5EFE2;fontSize=14;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="460" y="3578" width="560" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="O1" value="Unrelated problem found: open a GitHub Issue; do not fix it in this branch" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7E9EA;strokeColor=#7A2230;strokeWidth=1.5;dashed=1;fontColor=#5E1A26;fontSize=12.5;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="44" y="794" width="360" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="O2" value="Push rejected or blocked: stop; open or update an issue; tell a human" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7E9EA;strokeColor=#7A2230;strokeWidth=1.5;dashed=1;fontColor=#5E1A26;fontSize=12.5;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="44" y="1740" width="360" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="Nt3" value="Do not create the worktree with a raw git worktree add. Enjoy must track it for its Merge and Delete controls." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EADB;strokeColor=#D9C48A;strokeWidth=1;dashed=1;fontColor=#6E6555;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="1120" y="688" width="440" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="Nt8" value="PR body: Summary &#183; Why (Closes #n) &#183; testing per criterion &#183; Risks &#183; Rollback plan." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EADB;strokeColor=#D9C48A;strokeWidth=1;dashed=1;fontColor=#6E6555;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1848" width="440" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="Nt12" value="If another PR bumped the version on master, renumber yours to the next unused number before you merge." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EADB;strokeColor=#D9C48A;strokeWidth=1;dashed=1;fontColor=#6E6555;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="1120" y="2796" width="440" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="Nt16" value="Do not use git worktree remove --force or git branch -D without explicit human approval." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F1EADB;strokeColor=#D9C48A;strokeWidth=1;dashed=1;fontColor=#6E6555;fontSize=11;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontFamily=Georgia;" vertex="1" parent="1">
