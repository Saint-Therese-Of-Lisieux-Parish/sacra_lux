        <mxCell id="N2" value="git fetch origin &#8212; sync refs before you branch" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1A2230;gradientColor=#121A29;gradientDirection=north;strokeColor=#4C8DFF;strokeWidth=2;fontColor=#E6EDF3;fontSize=13.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
